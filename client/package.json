{
  "name": "gosu-lsp",
  "displayName": "Gosu Programming Language Support",
  "description": "Language support for Gosu (.gs, .gsx) files — syntax highlighting, diagnostics, completion, hover, and go-to-definition via LSP.",
  "version": "0.3.4",
  "publisher": "ronella",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcw3bb/gosu-lsp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "gosu",
    "language server",
    "lsp"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gosu",
        "aliases": [
          "Gosu",
          "gosu"
        ],
        "extensions": [
          ".gs",
          ".gsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gosu",
        "scopeName": "source.gosu",
        "path": "./syntaxes/gosu.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
